# Server Config
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Required database configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Generate a private random secret with at least 32 characters; never commit the real value.
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-characters

# Optional: comma-separated DNS server IPs if Node cannot resolve Atlas SRV records
# MONGODB_DNS_SERVERS=
